# App
APP_NAME=Wildfire Monitoring API
APP_VERSION=1.0.0
ENVIRONMENT=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wildfire_db
DB_USER=wildfire_admin
DB_PASSWORD=wildfire_password

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cache / Messaging
REDIS_URL=redis://localhost:6379
MQTT_HOST=localhost
MQTT_PORT=1883

# NASA FIRMS satellite hotspot feed
# Register free at: https://firms.modaps.eosdis.nasa.gov/api/
# After login, go to "API Key" → copy your MAP_KEY
FIRMS_MAP_KEY=
# Bounding box: west,south,east,north (default = Thanh Hoa province)
FIRMS_BBOX=104.2,19.0,106.5,20.8
# Auto-sync every N hours (0 = disable background sync)
FIRMS_SYNC_HOURS=3

# Camera AI integration
# Path to GeoTIFF DEM file (SRTM/ASTER) for fire coordinate calculation
# Leave blank to skip DEM-based coordinate calculation
DEM_PATH=
# Path to admin boundary shapefile (GADM level 3 for Vietnam)
# Leave blank to skip commune/district lookup
SHAPEFILE_PATH=

# SMTP email alerts for fire detections (confidence >= 0.8)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
# Comma-separated list of alert recipient emails
ALERT_EMAIL_RECIPIENTS=
