# App
APP_NAME=Wildfire Monitoring API
APP_VERSION=1.0.0
ENVIRONMENT=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=wildfire_db
DB_USER=wildfire_admin
DB_PASSWORD=wildfire_password

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cache / Messaging
REDIS_URL=redis://localhost:6379
MQTT_HOST=localhost
MQTT_PORT=1883
